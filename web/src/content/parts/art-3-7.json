      ],
      "action": {
        "label": "실습",
        "items": [
          {
            "kind": "link",
            "href": "https://github.com/Comfy-Org/comfy-cli",
            "text": "Comfy CLI 소스와 도움말"
          },
          {
            "kind": "copy",
            "value": "comfy --json cloud login --no-browser",
            "desc": "로그인 시작"
          },
          {
            "kind": "copy",
            "value": "comfy cloud whoami",
            "desc": "내 계정 확인"
          }
        ]
      }
    },
    {
      "id": "art-3-7-auth",
      "title": "Comfy CLI 브라우저 접근 요청",
      "template": "screen",
      "screen": {
        "kind": "browser",
        "capture": "/lectures/images/session3/captures/comfy-auth.png",
        "url": "https://cloud.comfy.org/oauth/authorize",
        "src": "/lectures/images/session3/captures/comfy-auth.png",
        "page": {
          "kind": "comfy-auth",
          "workspace": "Personal Workspace",
          "permissions": [
            "comfy-cloud:workflows:read",
            "comfy-cloud:workflows:write",
            "comfy-cloud:jobs:read",
            "comfy-cloud:jobs:write",
            "comfy-cloud:files:read",
            "comfy-cloud:files:write",
            "comfy-cloud:assets:read",
            "comfy-cloud:assets:write",
            "comfy-cloud:hub:read",
            "comfy-cloud:hub:write",
            "comfy-cloud:user:read"
          ],
          "callback": "http://127.0.0.1:62829/callback",
          "logo": "/lectures/images/session3/captures/comfy-auth-icons.png",
          "workspaceBadge": 1,
          "continueBadge": 2
        }
      },
      "notes": [
        {
          "n": 1,
          "head": "워크스페이스",
          "body": "내 Comfy 계정의 작업 공간 확인"
        },
        {
          "n": 2,
          "head": "Continue",
          "body": "접근 권한 확인 뒤 진행하는 버튼"
        },
        {
          "n": "!",
          "head": "인증 완료 확인",
          "body": "승인 뒤 CLI 완료 응답·whoami 확인 · 이번 캡처는 승인 전"
        }
      ]
    }
  ],
  "summary": "링크 출력과 인증 완료 구분"
